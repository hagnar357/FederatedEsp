/* Overlay for the generic ESP32 (classic, esp32_devkitc/esp32/procpu) boards: only the LittleFS mount and the flash
 * partitions of app.overlay (that one has the Heltec V3 / ESP32-S3 pins). Select it with DTC_OVERLAY_FILE=esp32.overlay,
 * see BOARD/OVERLAY/CHIP in run_zephyr.sh. */
/ {
	fstab {
		compatible = "zephyr,fstab";
		lfs1: lfs1 {
			compatible = "zephyr,fstab,littlefs";
			mount-point = "/storage";
			partition = <&storage_partition>;
			automount;
			read-size = <16>;
			prog-size = <16>;
			cache-size = <64>;
			lookahead-size = <32>;
			block-cycles = <512>;
		};
	};
};

/* The classic ESP32 loads its second stage from 0x1000 (the S3 from 0x0): the runner flashes zephyr.bin at the
 * boot_partition address, so it must be at 0x1000 (stock layout: partitions_0x1000_amp_4M.dtsi). Code at 0x20000,
 * then 2.75 MB of storage; everything inside the 4 MB flash of the chip. */
&flash0 {
	/delete-node/ partitions;
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@1000 {
			label = "mcuboot";
			reg = <0x00001000 0x0000F000>;
			read-only;
		};

		sys_partition: partition@10000 {
			label = "sys";
			reg = <0x00010000 0x00010000>;
		};

		slot0_partition: partition@20000 {
			label = "image-0";
			reg = <0x00020000 0x000F0000>;
		};

		storage_partition: partition@110000 {
			label = "storage";
			reg = <0x00110000 0x002C0000>;
		};
	};
};
